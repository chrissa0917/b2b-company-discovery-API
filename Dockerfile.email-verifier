FROM golang:1.23-alpine AS build
WORKDIR /src

# Build from the preserved local snapshot so production does not depend on
# AfterShip/email-verifier remaining available on GitHub.
COPY third_party/aftership-email-verifier ./third_party/aftership-email-verifier
COPY email_verifier/main.go ./main.go

RUN printf '%s\n' \
      'module buyandrentrobots-email-verifier' \
      '' \
      'go 1.23' \
      '' \
      'require github.com/AfterShip/email-verifier v0.0.0' \
      '' \
      'replace github.com/AfterShip/email-verifier => ./third_party/aftership-email-verifier' \
      > go.mod \
    && go mod tidy \
    && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /email-verifier ./main.go

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /email-verifier /usr/local/bin/email-verifier
EXPOSE 8080
CMD ["/usr/local/bin/email-verifier"]
