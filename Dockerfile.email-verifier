FROM golang:1.23-alpine AS build
WORKDIR /src
COPY email_verifier/main.go ./main.go
RUN go mod init buyandrentrobots-email-verifier \
    && go get github.com/AfterShip/email-verifier@d8462fdd79d9aca5452bd220f9cd5224976fea49 \
    && go mod tidy \
    && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /email-verifier ./main.go

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /email-verifier /usr/local/bin/email-verifier
EXPOSE 8080
CMD ["/usr/local/bin/email-verifier"]
