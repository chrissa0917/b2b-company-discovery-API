FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-contact-enricher.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt \
    && playwright install chromium --with-deps
COPY contact_enricher ./contact_enricher
CMD ["python", "-m", "contact_enricher.open_source_email_benchmark"]
